<script type="text/javascript">
    if (window.location.href.indexOf("return_to=%2Fhc%2Frequests") > -1) {
        window.location.href = "/hc/en-gb/articles/{{settings.article_id_confirmation}}";
    }
</script>


<!-- Main content -->
<!-- Banner -->
<section id="tl-home--banner">
    <div class="govuk-width-container">
        <div class="govuk-grid-row" style="text-align: right;padding-top: 5px;">
            <div class="govuk-grid-column-full">
                {{#each categories}}
                {{#is name "News and updates"}}
                <a id="tl-home-waw--article" class="govuk-link" href="{{url}}">{{name}}</a>
                {{/is}}
                {{/each}}
            </div>
        </div>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full">
                <div class="tl-home--banner">
                    <div class="tl-home--banner--column-two-thirds">
                        <div class="tl-home--banner--card govuk-!-padding-8">
                            <h1 class="govuk-heading-l govuk-!-margin-bottom-5 govuk-!-margin-top-0">{{settings.homepage_banner_title}}</h1>
                            <p class="govuk-body-l">{{settings.homepage_banner_text_1}}</p>
                            <p class="govuk-body-l">{{settings.homepage_banner_text_2}}</p>
                            <p class="govuk-body govuk-!-margin-bottom-0"><a class="govuk-button govuk-!-margin-bottom-0" id="tl-home-banner--cta" href="/hc/en-gb/articles/{{settings.homepage_banner_button_article}}">{{settings.homepage_banner_button}}</a></p>
                        </div>
                    </div>
                    <div class="tl-home--banner--column-one-third">
                        <img class="tl-image--cover tl-home--banner--column--image" src="{{settings.homepage_banner_image}}" />
                    </div>
                </div>
            </div>


        </div>
    </div>
</section>

<!-- Benefits -->
<section id="tl-home--benefits" class="govuk-!-margin-top-5">
    <div class="govuk-width-container">

        <div class="govuk-grid-row tl-row-fill">
            <div class="govuk-grid-column-one-third tl-row-fill">
                <h2 class="govuk-heading-l tl-home--benefit">{{settings.benefit_section_1_percentage}}<br /><p class="govuk-!-font-weight-regular"></p><p class="govuk-body">{{settings.benefit_section_1_content}}</p></h2>
            </div>
            <div class="govuk-grid-column-one-third tl-row-fill">
                <h2 class="govuk-heading-l tl-home--benefit">{{settings.benefit_section_2_percentage}} <br /><p class="govuk-!-font-weight-regular"></p><p class="govuk-body">{{settings.benefit_section_2_content}}</p></h2>
            </div>
            <div class="govuk-grid-column-one-third tl-row-fill">
                <h2 class="govuk-heading-l tl-home--benefit">{{settings.benefit_section_3_percentage}} <br /><p class="govuk-!-font-weight-regular"></p><p class="govuk-body">{{settings.benefit_section_3_content}}</p></h2>
            </div>
        </div>
    </div>
</section>

<!-- IA -->
<section id="tl-home--ia">
    <div class="govuk-width-container govuk-main-wrapper">
        <h2 class="govuk-heading-m">About T Levels and industry placements</h2>
        <div class="tl-home--quicklinks">
            <div class="tl-home--quicklink">
                <span class="tl-home--quicklink--image"></span>
                <h3 class="govuk-heading-s"><a href="{{settings.quick_link_1_url
                    }}" class="govuk-link">{{settings.quick_link_1_heading}}</a></h3>
                    <p class="govuk-body">{{settings.quick_link_1_content}}</p>
</div>

            <div class="tl-home--quicklink">
                <span class="tl-home--quicklink--image"></span>
                <h3 class="govuk-heading-s"><a href="{{settings.quick_link_2_url}}" class="govuk-link">{{settings.quick_link_2_heading}}</a></h3>
                <p class="govuk-body">{{settings.quick_link_2_content}}</p>
            </div>

            <div class="tl-home--quicklink">
                <span class="tl-home--quicklink--image"></span>
                <h3 class="govuk-heading-s"><a href="{{settings.quick_link_3_url}}" class="govuk-link">{{settings.quick_link_3_heading}}</a></h3>
                <p class="govuk-body">{{settings.quick_link_3_content}}</p>
            </div>

            <div class="tl-home--quicklink">
                <span class="tl-home--quicklink--image"></span>
                <h3 class="govuk-heading-s"><a href="{{settings.quick_link_4_url}}" class="govuk-link">{{settings.quick_link_4_heading}}</a></h3>
                <p class="govuk-body">{{settings.quick_link_4_content}}</p>
            </div>


        </div>
    </div>

</section>

<!-- FAP -->
{{#if settings.fap_enabled}}
<section id="tl-home--fap">
    <div class="govuk-width-container">
        <div class="tl-fap-tile--home"></div>
    </div>
</section>
{{/if}}




<!-- Lower Boxes -->
<section id="tl-home--lower">
    <div class="govuk-width-container govuk-!-margin-bottom-5 govuk-!-margin-top-5">

        <div id="tl-home--contact" class="tl-js-visible">
            <div class="govuk-grid-row tl-row-fill">
                <div class="govuk-grid-column-one-third tl-row-fill">
                    <div class="tl-card--purple" id="tl-home--question">
                        <h3 class="govuk-heading-m">Case studies</h3>
                        <p class="govuk-body">
                            Discover the <a href="/hc/en-gb/categories/{{settings.article_id_benefits}}" class="govuk-link">benefits</a> of hosting an industry placement student at your organisation. 
                        </p>
                    </div>
                </div>

                <div class="govuk-grid-column-one-third tl-row-fill">
                    <div class="tl-card--purple" id="tl-home--question">
                        <h3 class="govuk-heading-m">Have a T Levels question?</h3>
                        <p class="govuk-body">
                            Our T Levels support bot is here to help you find the answers. <a href="#" id="tl-home--answerbot" class="govuk-link">Ask the support bot a question</a>
                        </p>
                    </div>
                </div>

                <div class="govuk-grid-column-one-third tl-row-fill">
                    <div class="tl-card--purple tl-js-hidden" id="tl-home--ticket">
                        <h3 class="govuk-heading-m">Contact us</h3>
                        <p class="govuk-body">If you'd like to speak to someone about T Levels, or can't find what you're looking for, {{#link 'new_request' class='govuk-link tl-home--contact'}}contact us{{/link}}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (!isAgent()) {
            $("#tl-home--ticket").show();
        }
    });

    $('#tl-home--answerbot').click(function () {
        openHelp();
        event.preventDefault();
    });

    $("#tl-home-lower--image").attr("src", "{{settings.home_image_lower}}");
</script>

<script src="{{asset 'findProviderTileHome.js'}}"></script>
<script>
    new FindProviderTileHome("/hc/en-gb/articles/{{settings.article_id_find_provider}}",
                         "{{settings.find_provider_api_uri}}",
                         "{{settings.find_provider_api_app_id}}",
                         "{{settings.find_provider_api_key}}",
                         "{{settings.article_id_eoi}}");

</script>

<!-- Start of tlevelsemployertest Zendesk Widget script -->
<script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key={{settings.answerbot_key}}"></script>

<script type="text/javascript">
    window.zESettings = {
        webWidget: {
            answerBot: {
                avatar: {
                    url: "{{settings.answerbot_icon}}",
                    name: {
                        "*": '{{settings.answerbot_name}}'
                    }
                },
                title: {
                    "en-gb": "T Levels Employer Support"
                },
                search: {
                    labels:
                        ['answerbot']
                },
                contactOnlyAfterQuery: true
            }
        }
    };
</script>
<!-- End of tlevelsemployertest Zendesk Widget script -->

<script>
    if ($('#tl-workshopsandwebinars').children().length == 0) {
        $('#tl-workshopsandwebinars').html('<p class="govuk-body">There are currently no upcoming T Level events.</p>')
    }
</script>